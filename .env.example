# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=voxcribe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voxcribe

# --- Speech recognition ---
STT_PROVIDER=faster_whisper
# Multilingual model baked into the backend image at build time:
# tiny | base | small | medium | large-v3   (never the *.en variants)
# Changing it needs: docker compose build backend
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Networking ---
# Origin(s) the browser loads the UI from (comma separated). Used for CORS + WebSocket origin checks.
CORS_ORIGINS=http://localhost:3000
# Host port for the UI (must match the port in CORS_ORIGINS)
FRONTEND_PORT=3000
# Backend URL as the BROWSER sees it. Baked into the frontend at build time:
# changing it needs: docker compose build frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
